# Supabase project settings > API (safe browser-visible public values)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Older Supabase projects may expose an anon key; that is also a public client key.
# NEVER put secret/service_role keys in VITE_ variables or in GitHub Pages.
